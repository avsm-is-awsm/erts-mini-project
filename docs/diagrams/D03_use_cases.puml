@startuml D03_use_cases
!include _style.iuml
left to right direction
title D03 Use cases
actor "Operator / Trader" as OP
actor "Market Data Feed" as FEED
actor "Order Gateway" as GW
actor "Fair-Value Service" as FV
actor "Analyst" as AN
rectangle "DK1 tick-to-trade engine" {
  usecase "UC1 Configure strategy\n& risk limits" as UC1
  usecase "UC2 Load dataset and run\nreplay session (HW / SW)" as UC2
  usecase "UC3 Detect mispricing\nand send order" as UC3
  usecase "UC4 Update fair value\n(in-band V)" as UC4
  usecase "UC5 Emergency stop\n(kill switch)" as UC5
  usecase "UC6 Collect results, measure\nlatency / throughput" as UC6
  usecase "UC7 Verify outputs\nagainst golden model" as UC7
}
OP --> UC1
OP --> UC2
OP --> UC5
FEED --> UC3
UC3 --> GW
FV --> UC4
AN --> UC6
AN --> UC7
UC2 ..> UC3 : <<include>>
UC2 ..> UC6 : <<include>>
UC4 ..> UC3 : <<extend>>
UC5 ..> UC3 : <<extend>>\nblocks
@enduml
