!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #444444
skinparam ClassBorderColor #2364aa
skinparam ClassBackgroundColor #f4f7fb
skinparam PackageBorderColor #6b6b6b
skinparam StateBorderColor #2364aa
skinparam StateBackgroundColor #f4f7fb
skinparam ActivityBorderColor #2364aa
skinparam ActivityBackgroundColor #f4f7fb
skinparam UsecaseBorderColor #2364aa
skinparam UsecaseBackgroundColor #f4f7fb
skinparam NoteBackgroundColor #fffbe6
skinparam NoteBorderColor #c9a227
hide empty members
